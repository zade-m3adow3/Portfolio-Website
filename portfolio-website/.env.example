# ═══════════════════════════════════════════════════════════════
# Project Antigravity — Environment Variables
# ═══════════════════════════════════════════════════════════════
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in all values (never commit .env.local to git)
# 3. Add the same vars in Vercel: Dashboard → Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your_service_role_key...  # NEVER expose to browser

# ── OpenAI ───────────────────────────────────────────────────
# Used for: text-embedding-3-small (embeddings) + gpt-4o-mini (generation)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your_openai_key...

# ── Upstash Redis (rate limiting) ────────────────────────────
# Create free DB at: https://console.upstash.com → Redis → Create Database
# Copy "REST URL" and "REST Token" from the database dashboard
UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...your_upstash_token...

# ── Sentry (error tracking) ──────────────────────────────────
# Create project at: https://sentry.io → New Project → Node.js
# Copy DSN from: Project Settings → Client Keys → DSN
SENTRY_DSN=https://YOUR_KEY@oXXXXX.ingest.sentry.io/XXXXXX

# ── Security ─────────────────────────────────────────────────
# Random string used to salt IP hashes in research_logs (run: openssl rand -hex 32)
IP_HASH_SALT=replace_with_random_64_char_hex_string

# ── CORS (Edge Function) ─────────────────────────────────────
# Your deployed Vercel domain — restrict CORS to this origin in production
ALLOWED_ORIGIN=https://your-portfolio.vercel.app

# ── Vercel (auto-set by Vercel, do not set manually) ─────────
# VERCEL_ENV=production | preview | development

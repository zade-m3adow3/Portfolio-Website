* ============================================================
* ch6_1_combinational_latency.cir
* 250-Stage 14 nm FinFET CMOS Inverter Chain — PVT Corner Sweep
* Purpose : Validate T_comb = 12.9 ns < 12.98 ns (77 MHz window)
*           across all 5 PVT corners (TT FF SS FS SF)
* Simulator: ngspice / LTspice (compatible netlist)
* ============================================================

* ---- Supply voltage (nominal 0.8 V for 14 nm) ----
.PARAM VDD_nom = 0.8
.PARAM VDD = {VDD_nom}

* ---- Process corner scaling factors ----
* Controlled by .PARAM corner_nmos / corner_pmos
* TT: 1.0/1.0  FF: 0.85/0.85  SS: 1.2/1.2  FS: 0.85/1.2  SF: 1.2/0.85
.PARAM corner_nmos = 1.0
.PARAM corner_pmos = 1.0

* ---- Temperature (set per run) ----
.TEMP 27

* ---- Power Supply ----
VDD VDD 0 DC {VDD}

* ---- 14 nm FinFET NMOS model (simplified BSIM-CMG level 72) ----
* In a real flow, include the PDK model card here:
*   .lib '/path/to/14nm_FinFET_PDK.lib' tt
* Below is a parameterised behavioural approximation:

.SUBCKT INV_14NM IN OUT VDD VSS
* NMOS FinFET — 1 fin, W_fin=7nm, Hfin=46nm, L=14nm
MN OUT IN VSS VSS NMOS_14NM W=7n L=14n M={corner_nmos}
* PMOS FinFET — 1 fin
MP OUT IN VDD VDD PMOS_14NM W=7n L=14n M={corner_pmos}
.ENDS INV_14NM

* ---- Simplified Level-1 MOSFET models scaled to 14 nm ----
.MODEL NMOS_14NM NMOS LEVEL=1
+  VTO=0.22  KP=600u  GAMMA=0.4  PHI=0.8
+  LAMBDA=0.1  TOX=1.2n  LD=1n  RSH=5

.MODEL PMOS_14NM PMOS LEVEL=1
+  VTO=-0.22  KP=250u  GAMMA=0.4  PHI=0.8
+  LAMBDA=0.1  TOX=1.2n  LD=1n  RSH=5

* ---- 250-Stage Inverter Chain ----
* Generate with .SUBCKT instantiation loop
* (ngspice supports .FOR loops; LTspice users: expand manually or use .STEP)

X1   IN   N1   VDD 0 INV_14NM
X2   N1   N2   VDD 0 INV_14NM
X3   N2   N3   VDD 0 INV_14NM
X4   N3   N4   VDD 0 INV_14NM
X5   N4   N5   VDD 0 INV_14NM
X6   N5   N6   VDD 0 INV_14NM
X7   N6   N7   VDD 0 INV_14NM

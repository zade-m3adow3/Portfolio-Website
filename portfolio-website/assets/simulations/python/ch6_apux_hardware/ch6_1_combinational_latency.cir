* ---- Input stimulus: single 0→1 transition at t=1ns ----
VIN IN 0 PULSE(0 {VDD} 1n 20p 20p 20n 40n)

* ---- Load capacitor at output (fan-out = 4 equiv) ----
CLOAD OUT 0 4f

* ---- Transient simulation: 30 ns window, 1 ps step ----
.TRAN 1p 30n

* ---- Measure propagation delay (50% crossing) ----
.MEAS TRAN t_in  WHEN V(IN)=0.4 RISE=1
.MEAS TRAN t_out WHEN V(OUT)=0.4 RISE=1
.MEAS TRAN T_comb PARAM='t_out - t_in'
.MEAS TRAN margin PARAM='12.98n - T_comb'

* ---- PVT corners — run .cir five times with these param sets ----
* Corner TT (nominal): corner_nmos=1.0, corner_pmos=1.0, VDD=0.8, TEMP=27
* Corner FF (fast):    corner_nmos=0.85,corner_pmos=0.85,VDD=0.88,TEMP=-40
* Corner SS (slow):    corner_nmos=1.2, corner_pmos=1.2, VDD=0.72,TEMP=125
* Corner FS (fast-n):  corner_nmos=0.85,corner_pmos=1.2, VDD=0.8, TEMP=27
* Corner SF (slow-n):  corner_nmos=1.2, corner_pmos=0.85,VDD=0.8, TEMP=27

.OPTIONS ACCURATE RELTOL=1e-6

.END
